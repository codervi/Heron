@model List<BookingDetail>
@{
    ViewData["Title"] = "Bookings";
    var date = (DateTime)ViewBag.Date;
}

<h1>Bookings</h1>
<p class="subnav"><a asp-action="Index">Reports</a> <a asp-action="Rooms">Rooms</a></p>

<form method="get" class="inline-form">
    <label for="date">Day</label>
    <input type="date" id="date" name="date" value="@Fmt.IsoDate(date)">
    <button class="btn btn-small" type="submit">Show</button>
    <a class="btn btn-small btn-ghost" asp-action="Bookings" asp-route-date="@Fmt.IsoDate(date.AddDays(-1))">Previous day</a>
    <a class="btn btn-small btn-ghost" asp-action="Bookings" asp-route-date="@Fmt.IsoDate(date.AddDays(1))">Next day</a>
</form>

<h2>@Fmt.Date(date)</h2>
@if (Model.Count == 0)
{
    <div class="empty"><p>No bookings that day.</p></div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Time</th><th scope="col">Room</th><th scope="col">Customer</th><th scope="col">For</th><th scope="col">Status</th><th scope="col" class="num">Total</th><th scope="col"></th></tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@Fmt.Time(b.StartAt) to @Fmt.Time(b.EndAt)</td>
                    <td>@b.RoomName</td>
                    <td>@b.CustomerName<br><span class="muted">@b.CustomerEmail</span></td>
                    <td>@b.Title (@b.Attendees)</td>
                    <td><span class="badge badge-@b.Status.ToLower()">@b.Status</span></td>
                    <td class="num">@Fmt.Money(b.TotalPrice)</td>
                    <td>
                        @if (b.Status == "Confirmed")
                        {
                            <form asp-action="CancelBooking" asp-route-id="@b.Id" method="post" data-confirm="Cancel this booking?">
                                <input type="hidden" name="date" value="@Fmt.IsoDate(date)">
                                <button class="btn btn-small btn-danger" type="submit">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
