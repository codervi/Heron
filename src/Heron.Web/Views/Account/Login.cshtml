@model LoginForm
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
<form method="post" class="form narrow">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]">
    <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
    <div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username"><span asp-validation-for="Email" class="form-error"></span></div>
    <div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password"><span asp-validation-for="Password" class="form-error"></span></div>
    <button class="btn" type="submit">Sign in</button>
</form>
<p>New here? <a asp-action="Register">Create an account</a></p>
